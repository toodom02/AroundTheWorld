{
  "extends": "./node_modules/gts/tsconfig-google.json",
  "compilerOptions": {
    "lib": ["dom", "es2023"],
    "rootDir": ".",
    "outDir": "build",
    "module": "ES2020",
    "moduleResolution": "bundler",
    "strictPropertyInitialization": false,
    "allowSyntheticDefaultImports": true
  },
  "include": [
    "src/**/*.ts"
  ]
}
